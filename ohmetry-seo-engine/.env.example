# Copy to .env (never commit .env). All integrations are optional; without
# them the engine still crawls/audits and accepts CSV exports.

# PageSpeed Insights API key (Google Cloud console -> APIs & Services ->
# Credentials -> API key, restricted to "PageSpeed Insights API").
PAGESPEED_API_KEY=

# Path to a Google service-account JSON key file. Add the service account's
# email as a *Restricted* user in Search Console, and as a *Viewer* on the GA4
# property. Requires: pip install ".[google]"
GOOGLE_APPLICATION_CREDENTIALS=
