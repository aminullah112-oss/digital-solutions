---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const crumbs = [{ name: frontmatter.hub, href: frontmatter.hubHref }, { name: frontmatter.crumb, href: Astro.url.pathname }];
---
<Base title={frontmatter.title} description={frontmatter.description} breadcrumbs={crumbs}>
  <h1>{frontmatter.h1}</h1>
  <slot />
  <aside class="cta">
    <p><strong>Want these calculations in a workbook?</strong></p>
    <p>The <a href="/toolkit/">Electrical Engineer's Toolkit</a> is an Excel workbook from the author of this site.</p>
  </aside>
</Base>
