---
interface Props { title: string; description: string; breadcrumbs?: { name: string; href: string }[] }
const { title, description, breadcrumbs = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const crumbs = [{ name: 'Home', href: '/' }, ...breadcrumbs];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, Astro.site).toString(),
  })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {breadcrumbs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <style is:global>
      :root { --ink:#14202b; --muted:#5a6b78; --line:#d9e1e7; --accent:#0b6bcb; --bg:#fff; --card:#f4f7fa; }
      @media (prefers-color-scheme: dark) { :root { --ink:#e8eef3; --muted:#9fb0bd; --line:#2b3945; --accent:#5aa9ff; --bg:#0f161c; --card:#17212a; } }
      * { box-sizing: border-box }
      body { margin:0; font:17px/1.6 system-ui,-apple-system,Segoe UI,Roboto,sans-serif; color:var(--ink); background:var(--bg) }
      a { color:var(--accent) }
      header,main,footer { max-width:820px; margin:0 auto; padding:0 16px }
      header { display:flex; justify-content:space-between; align-items:center; padding-top:16px; padding-bottom:16px }
      header .brand { font-weight:700; font-size:1.2rem; text-decoration:none; color:var(--ink) }
      nav.crumbs { font-size:.9rem; color:var(--muted); margin-bottom:8px }
      h1 { line-height:1.2; margin:.2em 0 .5em }
      .calc { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:16px; margin:16px 0 24px }
      .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:12px }
      label { display:flex; flex-direction:column; font-size:.9rem; color:var(--muted); gap:4px }
      input,select { font:inherit; padding:10px; border:1px solid var(--line); border-radius:6px; background:var(--bg); color:var(--ink) }
      .result { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:8px; margin-top:16px }
      .result div { background:var(--bg); border:1px solid var(--line); border-radius:6px; padding:8px 12px }
      .result span { display:block; font-size:.8rem; color:var(--muted) }
      .result strong { font-size:1.2rem }
      .hint { color:var(--muted); min-height:1.6em }
      .print { margin-top:12px; font:inherit; padding:8px 14px; border:1px solid var(--line); border-radius:6px; background:var(--bg); color:var(--ink); cursor:pointer }
      footer { border-top:1px solid var(--line); margin-top:48px; padding-top:16px; padding-bottom:32px; font-size:.9rem; color:var(--muted) }
      footer a { margin-right:12px }
      .formula { background:var(--card); border-left:3px solid var(--accent); padding:8px 14px; font-family:ui-monospace,monospace }
      @media print { header,footer,.print,nav.crumbs { display:none } }
    </style>
  </head>
  <body>
    <header><a class="brand" href="/">Ohmetry</a><a href="/electrical/">Electrical</a></header>
    <main>
      {breadcrumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>{breadcrumbs.map((c) => <> &gt; <a href={c.href}>{c.name}</a></>)}
        </nav>
      )}
      <slot />
    </main>
    <footer>
      <a href="/about/">About</a><a href="/methodology/">Methodology</a><a href="/disclaimer/">Disclaimer</a><a href="/privacy/">Privacy</a><a href="/contact/">Contact</a>
      <p>Results are for estimating and checking. Verify against the current code and a qualified engineer before design or installation.</p>
    </footer>
  </body>
</html>
