rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && myRole() == 'ADMIN';
    }
    function isPhlebotomist() {
      return isSignedIn() && myRole() == 'PHLEBOTOMIST';
    }
    function isLab() {
      return isSignedIn() && myRole() == 'LABORATORY';
    }
    // The lab a LABORATORY-role account is staff of (users/{uid}.linkedEntityId). Self-service
    // onboarding (registerLaboratory, functions/src/index.ts) means laboratories/{labId} is no
    // longer only ever admin-seeded, trusted data — isLab() alone used to grant blanket read/
    // write on every booking, report, and tracking event regardless of which lab it belonged
    // to, which was harmless while every LABORATORY account was admin-provisioned by hand, but
    // becomes a real cross-tenant data leak once any self-registered lab can hold that role.
    function myLabId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedEntityId;
    }

    // A real online payment is only ever confirmed by the verifyRazorpayPayment Cloud
    // Function, after it recomputes and checks Razorpay's signature server-side — the Admin
    // SDK it uses bypasses these rules entirely, so this only constrains the ordinary client
    // SDK. Without it, a modified app could just write payment.status: SUCCESSFUL itself and
    // mark any booking paid without ever charging a card. Only trips on a NEW transition into
    // SUCCESSFUL, so it never blocks an unrelated later update (e.g. cancelling an
    // already-paid booking) once the Cloud Function has legitimately set it.
    function clientClaimsNewOnlinePaymentSuccess() {
      return ('payment' in request.resource.data) &&
        request.resource.data.payment.status == 'SUCCESSFUL' &&
        (!('payment' in resource.data) || resource.data.payment.status != 'SUCCESSFUL');
    }

    // Each signed-in user's own account doc. role/linkedEntityId are server- or
    // console-managed only — a client can never grant itself a staff role.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'PATIENT';
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.linkedEntityId == resource.data.linkedEntityId;
      allow delete: if false;

      match /addresses/{addressId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
      match /notifications/{notifId} {
        // Most notifications are written server-side by the onBookingStatusChange Cloud
        // Function reacting to a booking's status field. The client can also create its own —
        // covers the couple of cases that aren't themselves a booking-status transition
        // (assignment acceptance, sample rejection, complaint updates). A user creating a
        // notification in their own inbox is harmless: worst case is self-spam, never a leak.
        allow read, update, create: if isSignedIn() && request.auth.uid == uid;
        allow delete: if false;
      }
    }

    // Family member profiles, owned by the account that created them.
    //
    // A lab or phlebotomist only gets read access once they're actually involved in a
    // booking for this patient — authorizedLabIds/authorizedPhlebotomistUids are
    // maintained server-side by grantPatientAccessOnBookingWrite (functions/src/index.ts)
    // on every booking write, Admin SDK only, a client can never set these fields itself.
    // The old rule granted isLab()/isPhlebotomist() blanket read on every patient profile
    // regardless of any booking relationship — the same class of cross-tenant leak as
    // myLabId() above fixed for bookings/reports, just never closed here. .get(field, [])
    // defaults safely to an empty list for any patient doc predating this fix until
    // backfillPatientAccess (functions/src/index.ts) runs.
    match /patients/{patientId} {
      allow read: if isSignedIn() && (
        resource.data.accountOwnerUserId == request.auth.uid || isAdmin() ||
        (isPhlebotomist() && request.auth.uid in resource.data.get('authorizedPhlebotomistUids', [])) ||
        (isLab() && myLabId() in resource.data.get('authorizedLabIds', []))
      );
      allow write: if isSignedIn() && (
        request.resource.data.accountOwnerUserId == request.auth.uid || isAdmin()
      );
    }

    // Public catalog data. A self-registered lab (laboratories.onboardingStatus ==
    // 'PENDING_APPROVAL') stays invisible to every other signed-in user until an admin
    // approves it (active flips true) — only its own owner and admin can see it beforehand.
    // All writes go through registerLaboratory/updateLaboratoryProfile/
    // reviewLaboratoryOnboarding (functions/src/index.ts, Admin SDK bypasses these rules) or
    // the admin app's direct write; a lab can never flip its own active/onboardingStatus.
    match /laboratories/{labId} {
      allow read: if isSignedIn() && (
        resource.data.active == true || resource.data.ownerUserId == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
      // Pricing is non-sensitive catalog data (no patient PII), so a lab manages its own
      // directly from the client rather than needing a dedicated Cloud Function per field —
      // unlike the parent lab doc, which gates identity/approval fields behind functions.
      match /pricing/{investigationId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || (isLab() && myLabId() == labId);
      }
      // Fixed-price bundles (#the bundled-packages feature) — same non-sensitive-catalog-data
      // reasoning as pricing above: a lab manages its own packages directly, no Cloud Function
      // needed.
      match /packages/{packageId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || (isLab() && myLabId() == labId);
      }
    }
    match /investigations/{investigationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Bookings: the owning patient account, the assigned phlebotomist, lab staff, admin.
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.patientAccountOwnerUserId == request.auth.uid ||
        resource.data.assignedPhlebotomistUid == request.auth.uid ||
        (isLab() && resource.data.laboratoryId == myLabId()) || isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.patientAccountOwnerUserId == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.patientAccountOwnerUserId == request.auth.uid && !clientClaimsNewOnlinePaymentSuccess()) ||
        resource.data.assignedPhlebotomistUid == request.auth.uid ||
        (isLab() && resource.data.laboratoryId == myLabId()) || isAdmin()
      );
      allow delete: if false;

      // Append-only status-change log. Rules don't cascade from the parent match block to
      // a subcollection — this was missing entirely, so every trackingEvents write (patient
      // confirming a booking, phlebotomist/lab progressing it) fell through to the implicit
      // deny-all and crashed the app with an uncaught PERMISSION_DENIED. Same actor set as
      // the parent booking's own update rule; create-only since events are never edited.
      match /trackingEvents/{eventId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.patientAccountOwnerUserId == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedPhlebotomistUid == request.auth.uid ||
          (isLab() && get(/databases/$(database)/documents/bookings/$(bookingId)).data.laboratoryId == myLabId()) || isAdmin()
        );
        allow create: if isSignedIn() && (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.patientAccountOwnerUserId == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedPhlebotomistUid == request.auth.uid ||
          (isLab() && get(/databases/$(database)/documents/bookings/$(bookingId)).data.laboratoryId == myLabId()) || isAdmin()
        );
        allow update, delete: if false;
      }
    }

    // Medical history notes, scoped to the account that owns the family member they're about
    // (not necessarily the same uid as the family member's own patients/ doc).
    match /medicalRecords/{recordId} {
      allow read: if isSignedIn() && (resource.data.accountOwnerUserId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.accountOwnerUserId == request.auth.uid || isAdmin());
    }

    // Booking-ID sequence counters (BOOK-2026, etc.) — no sensitive data, just an incrementing
    // number a Firestore transaction updates atomically when a patient creates a booking.
    match /counters/{id} {
      allow read, write: if isSignedIn();
    }

    match /reports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.patientAccountOwnerUserId == request.auth.uid ||
        (isLab() && resource.data.laboratoryId == myLabId()) || isAdmin()
      );
      allow write: if (isLab() && request.resource.data.laboratoryId == myLabId()) || isAdmin();
    }

    match /complaints/{complaintId} {
      allow read: if isSignedIn() && (resource.data.patientAccountOwnerUserId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.patientAccountOwnerUserId == request.auth.uid;
      allow update: if isAdmin();
    }

    // Precomputed dashboard aggregate — admin reads it, only Cloud Functions write it.
    match /stats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
