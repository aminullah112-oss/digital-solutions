.claude/settings.local.json

# React/Vite app (app/) — dependencies and intermediate build output.
# The build's actual output is copied from /dist into the repo root and committed;
# /dist itself is just the staging folder from `npm run build` and isn't kept.
app/node_modules/
/dist/

# sheetmetal-pipeline: FreeCAD temp/backup files
*.FCBak
*.FCStd1

# sheetmetal-pipeline: generated CAD exports (never commit binaries)
sheetmetal-pipeline/output/

# Python bytecode cache
__pycache__/
*.pyc

# diagnostic-lab-app: Android/Gradle build output and local machine config
diagnostic-lab-app/**/build/
diagnostic-lab-app/.gradle/
diagnostic-lab-app/local.properties
diagnostic-lab-app/.idea/
diagnostic-lab-app/**/*.iml
diagnostic-lab-app/captures/

# diagnostic-lab-app: Firebase Cloud Functions — Node deps and TypeScript build output
diagnostic-lab-app/functions/node_modules/
diagnostic-lab-app/functions/lib/
