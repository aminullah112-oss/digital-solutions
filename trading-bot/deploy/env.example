# /etc/tradebot/env  (mode 640, root:tradebot). Read by systemd and the tradebot CLI.
# Never commit the real file.

# paper | live
TRADEBOT_MODE=paper
# Extra flags. Paper example: --feed kite --faults reject=0.02,timeout=0.01,stop_cancel=0.02
# Live example: --stop-type SL-M   (add --no-gtt only if you understand the overnight gap)
TRADEBOT_ARGS="--feed kite"

# Live trading stays locked until this is exactly I_ACCEPT_THE_RISK.
TRADEBOT_LIVE=

# Kite Connect app credentials (developer console). The access token is written
# daily by `tradebot login` to /var/lib/tradebot/state/kite_token.json.
KITE_API_KEY=
KITE_API_SECRET=

# Alerts (set at least one) and the dead-man heartbeat.
TRADEBOT_TELEGRAM_TOKEN=
TRADEBOT_TELEGRAM_CHAT=
TRADEBOT_WEBHOOK_URL=
TRADEBOT_HEARTBEAT_URL=

# Web panel (python -m tradebot web-passwd --totp prints both lines).
TRADEBOT_PANEL_PASSWORD_HASH=
TRADEBOT_PANEL_TOTP_SECRET=
