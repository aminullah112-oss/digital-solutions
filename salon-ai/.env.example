# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/salon_ai?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────
# Random 32+ char secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# ── Demo / Simulation Mode ─────────────────────────────────────────────
# When "true": webhook signature checks are skipped (so you can POST test
# payloads without real Meta credentials) and the live simulator can run.
DEMO_MODE="true"
# Interval range (ms) between simulated inbound messages when the simulator is on.
SIMULATION_MIN_INTERVAL_MS="10000"
SIMULATION_MAX_INTERVAL_MS="20000"

# ── AI Provider ─────────────────────────────────────────────────────────
# "rule-based" (default, offline, no credentials needed) or "anthropic".
AI_PROVIDER="rule-based"
ANTHROPIC_API_KEY=""

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── Instagram / Facebook Messenger (Meta) ──────────────────────────────
INSTAGRAM_VERIFY_TOKEN=""
FACEBOOK_VERIFY_TOKEN=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
# Shared by all Meta webhooks (WhatsApp/Instagram/Facebook) to verify
# the X-Hub-Signature-256 header on incoming webhook requests.
META_APP_SECRET=""

# ── Website Chat Widget ─────────────────────────────────────────────────
# Bearer token the embedded chat widget sends to /api/webhooks/website.
WEBSITE_CHAT_TOKEN=""
