# Copy to .env and set real values. Every setting is optional except in
# production, where SECRET_KEY must be set.

POWERTRACE_ENVIRONMENT=development

# PostgreSQL in production:
# POWERTRACE_DATABASE_URL=postgresql+psycopg://powertrace:password@localhost:5432/powertrace
POWERTRACE_DATABASE_URL=sqlite:///./powertrace.db

# Required outside development. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
POWERTRACE_SECRET_KEY=dev-only-insecure-key-change-me

# Initial administrator, created on first start only.
POWERTRACE_ADMIN_EMAIL=admin@example.com
POWERTRACE_ADMIN_PASSWORD=change-me-immediately

# Demo mode. Turn this OFF on a production installation.
POWERTRACE_DEMO_MODE=true

# Control writes are not implemented. This flag exists so the policy is
# visible in Settings; turning it on does not enable anything.
POWERTRACE_ALLOW_CONTROL_WRITES=false

# Voltage above which a measurement channel must declare an isolating device.
POWERTRACE_DIRECT_INPUT_VOLTAGE_LIMIT_V=60

# Polling
POWERTRACE_DEFAULT_POLL_INTERVAL_MS=1000
POWERTRACE_STALE_AFTER_S=5

# AI layer. "none" leaves the deterministic engine running on its own.
POWERTRACE_AI_PROVIDER=none
POWERTRACE_AI_MODEL=claude-sonnet-5
# POWERTRACE_AI_API_KEY=
